#!/usr/bin/env bash
set -e
sudo pacman -S --needed apparmor
sudo systemctl enable apparmor
LSM="lsm=landlock,lockdown,yama,integrity,apparmor,bpf"
if grep -q apparmor /sys/kernel/security/lsm; then
  echo "AppArmor already enabled in kernel, skipping kernel parameter"
elif [ -f /etc/default/grub ]; then
  grep -q "apparmor" /etc/default/grub || \
    sudo sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"|GRUB_CMDLINE_LINUX_DEFAULT=\"\1 $LSM\"|" /etc/default/grub
  sudo grub-mkconfig -o /boot/grub/grub.cfg
elif ls /boot/loader/entries/*.conf >/dev/null 2>&1; then
  for f in /boot/loader/entries/*.conf; do
    grep -q "apparmor" "$f" || sudo sed -i "/^options/ s|$| $LSM|" "$f"
  done
else
  echo "Add $LSM to your kernel parameters manually"
fi
echo "Done. Reboot, then run: aa-enabled && sudo aa-status"

